RewriteEngine On

# 1. Erzwinge HTTPS (Sicherheits-Verschlüsselung)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Sperre den Direktzugriff auf die SQLite-Datenbankdatei
<Files "kosync.db">
     Order allow,deny
     Deny from all
</Files>

# 3. Leite alle API-Anfragen sauber an die index.php weiter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
