RewriteEngine On

# 1. Erzwinge HTTPS (Sicherheits-Verschluesselung)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Direktzugriff auf Konfiguration, Datenbanken und Backup-Dateien blockieren
<FilesMatch "(?i)(^config\.php$|^config\.example\.php$|\.(db|sqlite|sqlite3)(-journal|-wal|-shm)?$|~$|\.(bak|old|orig|save|swp|swo)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Alle nicht existierenden Pfade an index.php weiterleiten
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
